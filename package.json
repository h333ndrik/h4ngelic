{
  "name": "h4ngelic",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "images:optimize": "node scripts/optimize-images.mjs",
    "assets:hero": "node scripts/build-font.mjs && node scripts/prepare-hero-assets.mjs",
    "assets:xray": "node scripts/prepare-xray-texture.mjs",
    "predev": "npm run images:optimize",
    "dev": "vite --host 0.0.0.0",
    "prebuild": "npm run images:optimize",
    "build": "vite build && node scripts/prerender.mjs",
    "preview": "node scripts/serve-preview.mjs --host 0.0.0.0",
    "preview:export": "npm run build && node scripts/export-preview.mjs",
    "test": "node --test tests/*.test.js",
    "test:browser": "node tests/browser.mjs",
    "test:artwork": "node tests/artwork-browser.mjs",
    "test:portfolio": "node tests/portfolio-browser.mjs",
    "test:micro": "node tests/microinteractions-browser.mjs",
    "test:gallery": "node tests/gallery-browser.mjs",
    "test:artwork-transitions": "node tests/artwork-transitions-browser.mjs",
    "test:seo": "node tests/seo-browser.mjs",
    "test:motion": "node tests/scroll-browser.mjs",
    "test:navigation": "node tests/navigation-browser.mjs",
    "test:easter": "node tests/easter-browser.mjs",
    "test:xray": "node tests/xray-browser.mjs",
    "test:mode-audio": "node tests/mode-audio-browser.mjs",
    "test:hover": "node tests/hover-browser.mjs",
    "test:corruption": "node tests/corruption-browser.mjs",
    "sounds:export": "node scripts/export-mode-sounds.mjs",
    "test:master": "node tests/master-browser.mjs",
    "measure:performance": "node scripts/measure-performance.mjs",
    "measure:xray": "node scripts/measure-xray.mjs",
    "test:material": "node tests/wordmark-corruption-browser.mjs",
    "assets:mode-icons": "node scripts/prepare-mode-icons.mjs",
    "test:icons": "node tests/ref09-icons-browser.mjs",
    "test:mode-foundation": "node tests/ref09-foundation-browser.mjs",
    "test:mode-snapshot": "node tests/mode-snapshot-browser.mjs",
    "test:interaction-mosh": "node tests/interaction-mosh-browser.mjs",
    "test:living-decay": "node tests/living-decay-browser.mjs",
    "test:normal-theme": "node tests/living-normal-browser.mjs",
    "test:end-reveal": "node tests/end-reveal-browser.mjs",
    "test:regression": "node scripts/check-interaction-regressions.mjs",
    "test:standalone": "node tests/standalone-browser.mjs && node tests/standalone-native-browser.mjs",
    "test:mobile": "node tests/mobile-interactions-browser.mjs"
  },
  "dependencies": {
    "three": "0.186.1"
  },
  "devDependencies": {
    "lighthouse": "13.5.0",
    "opentype.js": "1.3.4",
    "playwright": "1.64.1",
    "sharp": "0.35.5",
    "vite": "8.3.5"
  }
}
